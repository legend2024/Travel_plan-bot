# ==========================================================
# 环境变量示例模板
# 用法：复制为 .env 后填入自己的真实值
#   cp .env.example .env
# （.env 已被 .gitignore 忽略，不会提交；本模板文件会被提交到仓库）
# ==========================================================

# --- 高德地图 Web 服务 Key（地理编码 / 路线规划 / 周边搜索 / 静态地图）---
# 申请地址：https://lbs.amap.com/ ，创建应用后选择「Web服务」类型
AMAP_API_KEY=your_amap_key_here

# --- 大模型 Key ---
# 本项目默认使用阿里云百炼（DashScope），此处填百炼的 API Key
OPENAI_API_KEY=your_dashscope_api_key_here

# --- 大模型接口地址 ---
# 指向百炼的 OpenAI 兼容模式；若改用其它兼容 OpenAI 的服务，替换此地址即可
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
